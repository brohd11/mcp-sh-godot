extends "res://addons/_lib/gdsh/src/core/command_base.gd"
## `{{.Usage}}`: a gdsh command, served by the mcp-sh-godot bridge (or Editor Console).
## The extends path is swapped when the command loads, for whichever gdsh copy is running, so
## leave it as it is. Extend command_base.gd directly, reach the library through its consts
## (Context, Options, Utils, Paths, ExitCode) and don't override _init. Edits apply on the next run.

const _HELP = \
"TODO: one-line summary, shown by list_commands.
Usage: {{.Usage}} [ARG...]"

#var verbose_flag := false


static func get_command_name() -> String:
	return "{{.Name}}"


static func get_self_command_data() -> Dictionary:
	return _command_data({
		&"help": _HELP,
		# Positional arguments it takes: a count, or "min:1", "min:0,max:2". Without this, none.
		&"positional_count": "min:0",
	})


